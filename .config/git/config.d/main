# vim: ft=gitconfig:ts=2:sw=2:noet

[init]
	defaultBranch = main
[commit]
	verbose = true
[alias]
	a = add
	aa = add .
	ap = add -p
	b = branch
	c = commit
	cn = commit --no-verify
	co = checkout
	cop = checkout -p
	dft = difftool
	l = pull
	lo = log --oneline --decorate
	pl = pull
	po = push origin
	pon = push origin --no-verify
	pot = push origin --tags
	por = push origin --remote
	r = remote
	rebase-author = rebase --exec 'git commit --amend --reset-author --no-edit'
	sh = show
	st = status
	tv = !git tag | sort -V
[pull]
	rebase = false
[push]
	autoSetupRemote = true
[core]
	pager = ~/.config/git/pager.sh
[diff-so-fancy]
	stripLeadingSymbols = false
[diff]
	tool = difftastic
[difftool]
	prompt = false
[difftool "difftastic"]
	cmd = difft "$LOCAL" "$REMOTE"
[pager]
	difftool = true
[interactive]
	diffFilter = sh -c 'command -v diff-so-fancy >/dev/null 2>&1 && exec diff-so-fancy --patch || cat'
[rerere]
	enabled = true
[filter "lfs"]
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
	clean = git-lfs clean -- %f
