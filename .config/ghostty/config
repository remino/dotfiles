# The Cyberwave theme needs to be available at:
#
#   ~/.config/ghostty/themes/Cyberwave
#
# You can clone the remino/customize repo and link it:
#
#   mkdir ~/opt
#   git clone https://github.com/remino/customize ~/opt/customize
#   cd ~/.config/ghostty
#   ln -s ~/opt/customize/ghostty/themes
#
theme = "Cyberwave"

clipboard-paste-bracketed-safe = true
clipboard-paste-protection = true
clipboard-read = allow
clipboard-write = allow
cursor-style = block
cursor-style-blink = true
cursor-click-to-move = true
macos-option-as-alt = true
# macos-titlebar-style = "hidden" # Removes native tabs
mouse-hide-while-typing = true
# mouse-shift-capture = true # Breaks mouse text selection
notify-on-command-finish = unfocused
notify-on-command-finish-action = bell, notify
notify-on-command-finish-after = 30s

config-file = ?macos-option.local
config-file = ?config.local
