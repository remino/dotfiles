# Prefer exact-case candidates, then fall back to case-insensitive and
# substring matching. This keeps `exa<Tab>` on lowercase `example` instead of
# inserting `Exa`, while still allowing `Ze<Tab>` and `Er<Tab>` to find `zero`.
zstyle ':completion:*' matcher-list \
	'' \
	'm:{[:lower:]-_}={[:upper:]_-}' \
	'm:{[:upper:]-_}={[:lower:]_-}' \
	'l:|=* r:|=*' \
	'm:{[:lower:]-_}={[:upper:]_-} l:|=* r:|=*' \
	'm:{[:upper:]-_}={[:lower:]_-} l:|=* r:|=*'

# Complete at an empty prompt instead of inserting a literal tab character.
zstyle ':completion:*' insert-tab no

# fzf-tab renders the selection UI itself. Keep zsh's menu available when the
# plugin is absent and normal completion is the fallback.
if (( ${plugins[(Ie)fzf-tab]} ))
then
	zstyle ':completion:*' menu no
fi

