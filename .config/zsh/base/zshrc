MESSAGE_FONT=( termino )

_message_figlet() {
	local termino_dir font font_dir
	local -a font_dirs

	font_dirs=(
		"$HOME/.local/share/figlet"
		/usr/local/share/figlet
	)

	for font in "${MESSAGE_FONT[@]}"
	do
		if figlet -f "$font" " " > /dev/null 2>&1
		then
			figlet -f "$font"
			return
		fi

		for font_dir in "${font_dirs[@]}"
		do
			if [ -f "$font_dir/$font.flf" ]
			then
				figlet -d "$font_dir" -f "$font"
				return
			fi
		done

		if [ "$font" = termino ] && _exists brew
		then
			termino_dir="$( brew --prefix termino 2> /dev/null )/share/figlet"
			if printf "font-probe\\n" | figlet -d "$termino_dir" -f "$font" > /dev/null 2>&1
			then
				figlet -d "$termino_dir" -f "$font"
				return
			fi
		fi
	done

	figlet -f banner
}

idbanner() {
	_exists figlet || return

	local user="$( whoami )"
	local host="@$( hostname )"
	local ident="$user$host"

	if _exists lolcat
	then
		local seed="${IDBANNER_SEED:-$( printf "%d" "$( printf "0x%s" "$( printf "%s" "$ident" | md5sum | cut -c1-4 )" )" | awk '{print $1 % 10000}' )}"
		printf "%s\\n%s\\n" "$user" "$host" | _message_figlet | lolcat -S "$seed"
		return
	fi

	printf "%s\\n%s\\n" "$user" "$host" | _message_figlet
}

intro() {
	if type _private_msg > /dev/null 2>&1
	then
		_private_msg && echo
	else
		idbanner && echo
	fi

	compactfetch && echo

	if _exists fortune
	then
		fortune -e -s && echo
	fi
}

if _is_demo
then
	repeat $(( LINES / 2 )) echo
	intro
fi

