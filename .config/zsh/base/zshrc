# Outside tmux, reflect the prompt directory or the command currently running
# in the terminal title. tmux owns the outer title for its own clients.
if [[ -z "$TMUX" ]]; then
	_terminal_title() {
		local title=$1
		title=${title//$'\e'/}
		title=${title//$'\a'/}
		title=${title//$'\n'/ }
		title=${title//$'\r'/ }
		print -rn -- $'\e]2;'"$title"$'\a'
	}

	_terminal_title_precmd() {
		_terminal_title "${HOST%%.*}:${PWD:t}"
	}

	_terminal_title_preexec() {
		_terminal_title "${HOST%%.*}:$1"
	}

	autoload -Uz add-zsh-hook
	add-zsh-hook precmd _terminal_title_precmd
	add-zsh-hook preexec _terminal_title_preexec
fi

