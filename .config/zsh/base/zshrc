if (( $+commands[zoxide] )) ; then
	add_cdpath_to_zoxide() {
		local pths=()

		setopt null_glob

		for pth in $cdpath; do
			[[ ! -d "$pth" ]] && continue
			for dir in $pth/*(-/N); do
				zoxide add "$dir"
			done
		done

		unsetopt null_glob
	}

	[ "$ZSH_ZOXIDE_PRELOAD" = "1" ] && add_cdpath_to_zoxide
