#!/bin/sh

# This intentionally does not create this repository's untracked template
# inputs. It reproduces a raw first yadm clone and retains a shell on failure.
set -u

work="$(mktemp -d "${TMPDIR:-/tmp}/remino-dotfiles-shell.XXXXXX")"
home="$work/home"

cleanup() {
	rm -rf "$work"
}
trap cleanup EXIT HUP INT TERM

export HOME="$home"
export XDG_CONFIG_HOME="$HOME/.config"
export XDG_DATA_HOME="$HOME/.local/share"
export XDG_CACHE_HOME="$HOME/.cache"
export XDG_STATE_HOME="$HOME/.local/state"
mkdir -p "$HOME"

printf '%s\n' '==> Cloning dotfiles with yadm into a fresh home'
if yadm clone --bootstrap file:///src; then
	printf '%s\n' '==> yadm clone completed successfully'
else
	status=$?
	printf '%s\n' "==> yadm clone failed (exit $status); the environment is retained for debugging" >&2
fi

cat << EOF

Debug environment
  HOME=$HOME
  source checkout=/src

Useful commands:
  yadm status
  yadm alt
  yadm bootstrap
  find "\$HOME" -maxdepth 3 -print | sort
EOF

if [ "$#" -gt 0 ]; then
	exec "$@"
fi
exec bash --noprofile --norc -i
