#!/bin/sh

# Start a disposable yadm clone in Docker and retain a shell for diagnosis.
set -eu

root="$(git -C "$(dirname -- "$0")" rev-parse --show-toplevel)"
image="remino-dotfiles-shell"

docker build --progress=plain --tag "$image" --file "$root/.config/dotfiles/bin/shell.Dockerfile" "$root"
exec docker run --rm -it "$image" "$@"
